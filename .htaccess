Options -Indexes

<FilesMatch "(^\.|config\.local\.php$|config\.local\.example\.php$|config\.sample\.php$|config\.php$|portfolio\.sql$|README\.md$)">
    Require all denied
</FilesMatch>

<IfModule mod_php7.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
    php_flag expose_php Off
</IfModule>
